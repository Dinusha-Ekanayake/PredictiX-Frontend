# Copy to .env.local for development. On Vercel, set these in
# Project Settings -> Environment Variables instead (docs/DEPLOYMENT.md).
# Every NEXT_PUBLIC_ value is inlined into the browser bundle at build time:
# never put a secret here.

# Backend API base URL, no trailing slash. Required on Vercel (the build fails
# without it) and must be https in production.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional. WebSocket base for realtime notifications; defaults to the API URL
# with http(s) replaced by ws(s).
NEXT_PUBLIC_WS_URL=

# Optional. Only if the chatbot is ever served from a different origin.
NEXT_PUBLIC_CHATBOT_URL=

# Supabase project: Google sign-in and attachment uploads. The anon key is
# public by design; access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Show the demo accounts on the login page (default true). Set false once the
# demo phase ends, and disable or re-password those accounts in the database.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
